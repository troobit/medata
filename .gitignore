# Tmp
tmp/
temp/


# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local data
*.sqlite
*.db
data/
# In per-spec worktrees data may be a symlink to the main checkout's dataset;
# `data/` only matches directories, so ignore the root entry by name too.
/data
# …but the `data` spec DOMAIN (specs/PROCESS.md §3) is source, not a dataset.
!specs/data/

# Generated icons (only icon.svg is source of truth)
static/icon-*.png
static/apple-touch-icon.png
static/favicon.ico

# Orbit task management
**/.orbit/

# Swift / Xcode build artefacts
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
Package.resolved

# Segmenter model artefacts (generated by tools/segmenter/export.py, bundled at
# build time via the Pipeline target's Bundle.module; not committed — large binary).
# The committed Resources/README.md marker keeps the directory present.
MedataCore/Sources/Pipeline/Resources/segmenter.mlpackage/
MedataCore/Sources/Pipeline/Resources/segmenter.mlmodel
MedataCore/Sources/Pipeline/Resources/segmenter.mlmodelc/
tools/segmenter/build/
tools/segmenter/.venv/
tools/metafood3d/.venv/

# Bundled food databases (generated by tools/food_db/generate.py; committed as resources)
!MedataCore/Sources/Foods/Resources/*.sqlite

# Personal working notes — not tracked
nextup.md

# Variant comparison reports — per-session working artefacts of a multi-variant
# run, not a spec deliverable. The spec's own documents record what the
# comparison decided; the report itself is scratch. `**` matches any depth, so
# this covers every spec domain (specs/PROCESS.md §3) without a per-spec entry.
specs/**/comparison-report/

# In-repo per-spec worktrees (git metadata still lives in .git/worktrees/)
.worktrees/

# Python bytecode
__pycache__/
*.pyc

# Xcode per-user workspace state — contents.xcworkspacedata and xcuserdata are
# regenerated by Xcode and caused checkout conflicts when tracked.
MeData/MeData.xcodeproj/project.xcworkspace/
*.xcworkspace/xcuserdata/

# Scratch status file — working notes, not a tracked deliverable.
SPOUT.md
specs/BACKLOG.md
