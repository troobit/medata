<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Build stamp logged at launch (App/App.swift logLaunchIdentity) so an
	     installed binary can be matched against what was just built. Populated
	     by `make build-app` / `make deploy-release-stub` via the
	     MEDATA_BUILD_STAMP build setting; empty (=> "unstamped") on a plain
	     Xcode Run. All other Info.plist content is still generated by
	     GENERATE_INFOPLIST_FILE and merged with this file. -->
	<key>MedataBuildStamp</key>
	<string>$(MEDATA_BUILD_STAMP)</string>
	<!-- Custom URL scheme (PRD regression-suggestion-integration App 10):
	     medata://insulin/add opens the dose-entry sheet (AppRoot.onOpenURL).
	     Lives here because CFBundleURLTypes cannot be expressed as an
	     INFOPLIST_KEY_ build setting.
	     The array registers SCHEMES, not links: medata://capture,
	     medata://graph and medata://activity/add
	     (specs/data/activity-events Req 3.5) all arrive through this one
	     entry and are told apart by host and path in AppRoot.handleDeepLink.
	     A new link therefore adds no element here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>rtob.MeData</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>medata</string>
			</array>
		</dict>
	</array>
	<!-- cgm-connect Req 3.2: the LibreLinkUp best-effort background refresh
	     (BGAppRefreshTask, registered in App/GlucoseConnectionsModel.swift).
	     Array-valued keys live here because INFOPLIST_KEY_ build settings do
	     not merge arrays. HealthKit background delivery needs no
	     UIBackgroundModes entry — the entitlement covers it. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.medata.librelinkup.refresh</string>
	</array>
	<!-- cgm-direct Req 6.3: bluetooth-central lets a CoreBluetooth connect or
	     notify event wake (and state-restore relaunch) the app for the BLE
	     heartbeat. Self-service background mode; no signed entitlement
	     (cgm-direct Decision 4). Declared whether or not the developer-phase
	     heartbeat switch is on — an unused background mode is inert. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>bluetooth-central</string>
	</array>
	<!-- cgm-direct Req 6.3: shown on the Bluetooth permission prompt the
	     heartbeat enable triggers. Functional copy only (Req 5.4). -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bluetooth connects to the worn Libre sensor so each new reading can trigger a glucose fetch.</string>
	<!-- specs/ui/unified-dark-theme Decision 1: one dark presentation for the
	     whole process. Under dark resolution .systemGroupedBackground is
	     #000000 — identical to captureBackground — so the OLED capture family
	     and the grouped family converge without any view changing tokens.
	     Process-level on purpose (Req 1.4): no sheet, cover, or UIKit-hosted
	     surface can miss a root modifier that does not exist. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- capture-bundle-recorder smolspec: expose Documents (captures/ fixture
	     bundles) in the Files app and Finder — the recorder's sole management
	     surface. Developer-phase only; remove alongside the recorder before
	     any non-developer release (decision log, Decision 2). -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
