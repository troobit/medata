<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Build stamp logged at launch (App/App.swift logLaunchIdentity) so an
	     installed binary can be matched against what was just built. Populated
	     by `make build-app` / `make deploy-release-stub` via the
	     MEDATA_BUILD_STAMP build setting; empty (=> "unstamped") on a plain
	     Xcode Run. All other Info.plist content is still generated by
	     GENERATE_INFOPLIST_FILE and merged with this file. -->
	<key>MedataBuildStamp</key>
	<string>$(MEDATA_BUILD_STAMP)</string>
	<!-- Custom URL scheme (PRD regression-suggestion-integration App 10):
	     medata://insulin/add opens the dose-entry sheet (AppRoot.onOpenURL).
	     Lives here because CFBundleURLTypes cannot be expressed as an
	     INFOPLIST_KEY_ build setting. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>rtob.MeData</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>medata</string>
			</array>
		</dict>
	</array>
	<!-- cgm-connect Req 3.2: the LibreLinkUp best-effort background refresh
	     (BGAppRefreshTask, registered in App/GlucoseConnectionsModel.swift).
	     Array-valued keys live here because INFOPLIST_KEY_ build settings do
	     not merge arrays. HealthKit background delivery needs no
	     UIBackgroundModes entry — the entitlement covers it. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.medata.librelinkup.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<!-- capture-bundle-recorder smolspec: expose Documents (captures/ fixture
	     bundles) in the Files app and Finder — the recorder's sole management
	     surface. Developer-phase only; remove alongside the recorder before
	     any non-developer release (decision log, Decision 2). -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
