<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Build stamp logged at launch (App/App.swift logLaunchIdentity) so an
	     installed binary can be matched against what was just built. Populated
	     by `make build-app` / `make deploy-release-stub` via the
	     MEDATA_BUILD_STAMP build setting; empty (=> "unstamped") on a plain
	     Xcode Run. All other Info.plist content is still generated by
	     GENERATE_INFOPLIST_FILE and merged with this file. -->
	<key>MedataBuildStamp</key>
	<string>$(MEDATA_BUILD_STAMP)</string>
</dict>
</plist>
