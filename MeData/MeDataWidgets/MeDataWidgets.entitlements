<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- glucose-lock-widget Req 1: must match the group in
	     MeData/MeData.entitlements exactly. The extension only reads the
	     snapshot the app publishes; a missing or mis-provisioned group does
	     NOT make UserDefaults(suiteName:) nil, it silently yields a private
	     store, so the app→extension round-trip on device is the real check
	     (see specs/ui/glucose-lock-widget/prerequisites.md). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.rtob.MeData</string>
	</array>
	<!-- glucose-lock-widget Decision 16: read-only access to the LibreLinkUp
	     credentials and session the app stores, so getTimeline can fetch while
	     the app is suspended. Must match MeData.entitlements exactly. The
	     items are kSecAttrAccessibleAfterFirstUnlock, so a locked-phone fetch
	     works any time after the first unlock since boot. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)rtob.MeData.shared</string>
	</array>
</dict>
</plist>
